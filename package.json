{
  "name": "makasete-ai",
  "version": "1.0.0",
  "description": "EC Site Embedded Voice AI Makasete Server",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "start": "ts-node server/index.ts",
    "dev:server": "nodemon --watch 'server/**/*.ts' --exec 'ts-node' server/index.ts",
    "dev": "concurrently \"pnpm dev:server\" \"pnpm watch:widget\"",
    "build:widget": "vite build --config widget/vite.config.ts",
    "watch:widget": "vite build --config widget/vite.config.ts --watch",
    "build": "pnpm build:widget && tsc -p server",
    "start:prod": "node dist/server/index.js",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc -p server --noEmit && tsc -p widget",
    "tsx": "tsx"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.49.1",
    "@google/generative-ai": "^0.24.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "googleapis": "^171.4.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@google/clasp": "^3.3.0",
    "@langchain/anthropic": "^1.3.28",
    "@langchain/core": "^1.1.48",
    "@langchain/langgraph": "^1.3.2",
    "@octokit/rest": "^22.0.1",
    "@types/cors": "^2.8.19",
    "@types/dom-speech-recognition": "^0.0.11",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "concurrently": "^9.2.1",
    "esbuild": "0.28.0",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^8.0.14",
    "vitest": "^4.1.5"
  }
}
