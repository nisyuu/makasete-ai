{
  "name": "makasete-ai",
  "version": "1.0.0",
  "description": "EC Site Embedded Voice AI Makasete Server",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "start": "ts-node server/index.ts",
    "dev:server": "nodemon --watch 'server/**/*.ts' --exec 'ts-node' server/index.ts",
    "dev": "concurrently \"pnpm dev:server\" \"pnpm watch:widget\"",
    "build:widget": "vite build --config widget/vite.config.ts",
    "watch:widget": "vite build --config widget/vite.config.ts --watch",
    "build": "pnpm build:widget && tsc -p server",
    "start:prod": "node dist/server/index.js",
    "lint": "eslint .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc -p server --noEmit && tsc -p widget",
    "tsx": "tsx"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.53.1",
    "@google/generative-ai": "^0.24.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "googleapis": "^173.0.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@google/clasp": "^3.3.0",
    "@octokit/rest": "^22.0.1",
    "@types/cors": "^2.8.19",
    "@types/dom-speech-recognition": "^0.0.12",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.3",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@vitest/coverage-v8": "4.1.9",
    "concurrently": "^10.0.3",
    "esbuild": "0.28.1",
    "eslint": "^10.5.0",
    "globals": "^17.6.0",
    "happy-dom": "^20.10.6",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
