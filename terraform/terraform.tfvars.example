project_id      = "your-project-id"
container_image  = "asia-northeast1-docker.pkg.dev/your-project-id/makasete-ai-repo/makasete-ai:latest"

# API キーはここに書かない。Secret Manager に gcloud で登録する
# （リポジトリ直下の README.md「デプロイ」を参照）。
makasete_servers = {
  "server-1" = {
    google_sheets_id = "spreadsheet-id-1"
  },
  "server-2" = {
    google_sheets_id = "spreadsheet-id-2"
  }
}

# 埋め込みを許可するサイトの origin をカンマ区切りで指定する。
# "*" のままだと任意の第三者サイトから接続でき、LLM / TTS の利用料を
# 消費されるため、本番では必ず実際の origin を設定すること。
allowed_origins = "https://your-shop.example,https://www.your-shop.example"
tts_provider    = "gemini"

github_repository     = "your-username/makasete-ai"
