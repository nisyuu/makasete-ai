# Server Configuration
PORT=8080

# Comma-separated list of origins allowed to embed the widget.
# This is enforced for both HTTP (CORS) and the Socket.IO handshake.
# Leaving it unset (or setting "*") allows ANY site to connect and spend your
# LLM / TTS budget, so always set it in production.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Number of reverse proxies in front of this server. It decides which entry of
# X-Forwarded-For is treated as the client, and therefore what the rate limits
# are keyed by.
#   1 = Cloud Run only (default)
#   2 = one extra proxy in front (Firebase App Hosting, an external HTTPS load
#       balancer, a CDN, ...)
# If this is too low, every visitor collapses into a single rate-limit key and
# the whole site hits the limits together. Set LOG_PROXY_HEADERS=true once in
# the target environment and read the logged hop count to pick the right value.
TRUSTED_PROXY_COUNT=1

# Log the shape of X-Forwarded-For for the first requests after startup, so you
# can confirm TRUSTED_PROXY_COUNT. Leave it off in normal operation.
LOG_PROXY_HEADERS=false

# Concurrent Socket.IO connections allowed per client (default 20).
MAX_CONNECTIONS_PER_CLIENT=20

# Hard cap on responses generated at the same time in this process (default 8).
# This is the cost guard that does not depend on identifying clients correctly.
MAX_CONCURRENT_GENERATIONS=8

# Google Sheets Configuration
# The ID of the Google Spreadsheet (found in the URL)
GOOGLE_SHEETS_ID=your_spreadsheet_id_here

# Google Auth Configuration
# Path to your Google Service Account JSON key file.
# If you place it in the repository root as 'google-key.json', this is optional
# (that is the filename the code falls back to).
GOOGLE_APPLICATION_CREDENTIALS=./google-key.json

# Gemini API Configuration
# Get your API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# TTS Configuration (Optional)
# Providers: 'gemini' (default, free) or 'elevenlabs'
TTS_PROVIDER=gemini

# ElevenLabs Configuration (Required only if TTS_PROVIDER=elevenlabs)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
