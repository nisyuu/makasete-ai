# Server Configuration
PORT=8080

# Comma-separated list of origins allowed to embed the widget.
# This is enforced for both HTTP (CORS) and the Socket.IO handshake.
# Leaving it unset (or setting "*") allows ANY site to connect and spend your
# LLM / TTS budget, so always set it in production.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Google Sheets Configuration
# The ID of the Google Spreadsheet (found in the URL)
GOOGLE_SHEETS_ID=your_spreadsheet_id_here

# Google Auth Configuration
# Path to your Google Service Account JSON key file.
# If you place it in the repository root as 'google-key.json', this is optional
# (that is the filename the code falls back to).
GOOGLE_APPLICATION_CREDENTIALS=./google-key.json

# Gemini API Configuration
# Get your API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# TTS Configuration (Optional)
# Providers: 'gemini' (default, free) or 'elevenlabs'
TTS_PROVIDER=gemini

# ElevenLabs Configuration (Required only if TTS_PROVIDER=elevenlabs)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
